    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userNo",
      "value": "U1"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "companyId",
      "value": "1"
    },
    {
      "key": "unitOfMeasureId",
      "value": "1"
    },
    {
      "key": "currencyId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": ""
