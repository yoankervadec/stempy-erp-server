            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"where\": {\n    \"field\": \"name\",\n    \"op\": \"contains\",\n    \"value\": \"bolt\"\n  },\n  \"sort\": [\n    {\n      \"field\": \"unitAmount\",\n      \"dir\": \"desc\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Query: through relations, and/or/not",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/masterdata/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "masterdata",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"where\": {\n    \"and\": [\n      {\n        \"field\": \"category.code\",\n        \"op\": \"equals\",\n        \"value\": \"HW\"\n      },\n      {\n        \"or\": [\n          {\n            \"field\": \"unitAmount\",\n            \"op\": \"lessThan\",\n            \"value\": \"1.00\"\n          },\n          {\n            \"field\": \"productNo\",\n            \"op\": \"in\",\n            \"value\": [\n              \"P-001\",\n              \"P-002\"\n            ]\n          }\n        ]\n      },\n      {\n        \"not\": {\n          \"field\": \"createdByUser.userNo\",\n          \"op\": \"equals\",\n          \"value\": \"NOBODY\"\n        }\n      }\n    ]\n  },\n  \"sort\": [\n    {\n      \"field\": \"category.code\"\n    },\n    {\n      \"field\": \"name\",\n      \"dir\": \"asc\"\n    }\n  ],\n  \"page\": {\n    \"limit\": 10,\n    \"offset\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
