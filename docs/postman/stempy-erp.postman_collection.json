    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (stores the token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNo\": \"{{userNo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "No Authorization header on purpose: a stale token would be rejected (401) before login runs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged in\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", body.token);",
                  "if (body.defaultCompanyId) { pm.collectionVariables.set(\"companyId\", body.defaultCompanyId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (user, company, permissions)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": true
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
