                "key": "Content-Type",
                "value": "application/json",
                "disabled": true
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Ready (checks the database)",
