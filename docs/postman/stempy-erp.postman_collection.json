        {
          "name": "Query: name contains, sorted",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
