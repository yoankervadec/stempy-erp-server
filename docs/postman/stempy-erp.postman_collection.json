    {
      "name": "Scheduler",
      "description": "Recurring jobs: job types, schedules, manual runs and history. See docs/API_GUIDE.md section 7.",
      "item": [
        {
          "name": "List job types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scheduler/job-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scheduler",
                "job-types"
              ]
            },
            "description": "What can be scheduled: key, scope (SYSTEM / COMPANY / ANY), required permission, default schedule."
          }
        },
        {
          "name": "Preview a cron before saving",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scheduler/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scheduler",
                "preview"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleType\": \"CRON\",\n  \"cronExpression\": \"0 9 * * MON#1\",\n  \"timeZone\": \"America/Toronto\",\n  \"count\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Next fire times of an unsaved schedule (here: the first Monday of each month at 09:00). Nothing is stored."
          }
        },
        {
          "name": "Create schedule (stores id, version)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scheduler/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scheduler",
                "schedules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Purge sessions every 30 minutes (Postman)\",\n  \"description\": \"Created from the Postman collection\",\n  \"jobKey\": \"{{jobKey}}\",\n  \"scope\": \"SYSTEM\",\n  \"scheduleType\": \"INTERVAL\",\n  \"interval\": \"PT30M\",\n  \"maxRetries\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "scope SYSTEM needs scheduler.system.manage; drop it (default COMPANY) for a job whose scope allows companies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "  const row = pm.response.json();",
                  "  pm.collectionVariables.set(\"scheduleId\", row.id);",
                  "  pm.collectionVariables.set(\"scheduleVersion\", row.version);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List schedules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scheduler/schedules?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scheduler",
                "schedules"
