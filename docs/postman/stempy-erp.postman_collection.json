    {
      "key": "categoryVersion",
      "value": "0"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productVersion",
      "value": "0"
    },
    {
      "key": "jobKey",
      "value": "users.purge-expired-sessions",
      "description": "Job type used by the Scheduler requests (see List job types)"
