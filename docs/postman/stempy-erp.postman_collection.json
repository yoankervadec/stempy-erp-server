            "body": {
              "mode": "raw",
              "raw": "{\n  \"where\": {\n    \"field\": \"name\",\n    \"op\": \"contains\",\n    \"value\": \"bolt\"\n  },\n  \"sort\": [\n    {\n      \"field\": \"unitAmount\",\n      \"dir\": \"desc\"\n    }\n  ]\n}",
              "options": {
