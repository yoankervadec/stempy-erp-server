        {
          "name": "Query: through relations, and/or/not",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "X-Company-Id",
                "value": "{{companyId}}",
                "disabled": true,
                "description": "Enable to act in another company"
