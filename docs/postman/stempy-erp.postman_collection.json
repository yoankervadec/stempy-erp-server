{
  "info": {
    "name": "Stempy ERP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "See docs/API_GUIDE.md. Set userNo / password, run Auth > Login first; ids and versions are stored by the requests' test scripts. QUERY is a custom HTTP method (a GET with a body)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
