# Copy this file to .env (same folder, git-ignored) and fill in your values.
# Real environment variables override the values in .env.

# MySQL connection used by the server
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=stempy_erp
DATABASE_USER=stempy
DATABASE_PASSWORD=change-me

# Database used by the MySQL end-to-end tests (same host and user as above).
# The tests wipe it on every run, so the name must end in _test.
TEST_DATABASE_NAME=stempy_erp_test
